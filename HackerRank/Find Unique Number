"""
Find Unique

Given a list of integers where every element appears twice except for one unique element, find and return the unique element.
"""

from collections import Counter

def find_unique(nums):
    frequency = Counter(nums)

    for num, count in frequency.items():
        if count == 1:
            return num


nums = [4, 1, 2, 1, 2]
print(find_unique(nums))
# Expected Output: 4

# nums = [2, 2, 1]
print(find_unique(nums))
# Expected Output: 1

#%%

# Better answer

def find_unique(nums):
    unique = 0
    for num in nums:
        unique ^= num
    return unique


nums = [2, 2, 1]
print(find_unique(nums))
# Expected Output: 1

